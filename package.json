{
  "name": "sourcenote",
  "version": "0.1.0",
  "private": true,
  "description": "Lecture notes agent that verifies its own citations (Meta Global AI Developer Hackathon)",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "notarize:dmg": "xcrun notarytool submit release/*.dmg --keychain-profile sourcenote-notary --wait && xcrun stapler staple release/*.dmg",
    "dist:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "summarize": "tsx scripts/run-summary.ts",
    "add-pdf": "tsx scripts/add-pdf.ts",
    "correct": "tsx scripts/run-correct.ts",
    "check": "tsx scripts/run-check.ts",
    "export-sample": "tsx scripts/export-sample.ts",
    "eval-wer": "tsx scripts/eval-wer.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "Sourcenote",
  "author": "Park Jinsu"
}
